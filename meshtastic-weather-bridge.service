[Unit]
Description=Meshtastic Weather Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edward
WorkingDirectory=/home/edward/meshtastic-ws85-weather-bridge
ExecStart=/usr/bin/python3 /home/edward/meshtastic-ws85-weather-bridge/weather_bridge.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
